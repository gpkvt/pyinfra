[Interface]
PrivateKey = {{ secrets.get("privatekey", "missingPrivateKey") }}
{% for key, value in config.interface.items() -%}
{% if value is iterable and value is not string and value is not mapping -%}
{% for item in value -%}
{{ key }} = {{ item }}
{% endfor -%}
{% else -%}
{{ key }} = {{ value }}
{% endif -%}
{% endfor -%}

{% for peer in secrets.peers %}
[Peer]
{% for key, value in peer.items() -%}
{{ key }} = {{ value }}
{% endfor -%}
{% endfor %}
