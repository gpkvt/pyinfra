services:
  caddy:
    image: {{ image }}
    build:
      context: {{ homedir }}/.docker/caddy/build
    container_name: caddy
    restart: unless-stopped
    network_mode: host
    user: "{{ uid }}:{{ gid }}"
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    env_file:
      - {{ homedir }}/.docker/caddy/hetzner.env
    environment:
      XDG_DATA_HOME: /data
      XDG_CONFIG_HOME: /config
    volumes:
      - {{ homedir }}/.docker/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
      - {{ homedir }}/.docker/caddy/domains.txt:/etc/dehydrated/domains.txt:ro
      - {{ homedir }}/.docker/caddy/dehydrated.conf:/etc/dehydrated/config:ro
      - {{ homedir }}/.docker/caddy/dehydrated:/var/lib/dehydrated
      - {{ homedir }}/.docker/caddy/data:/data
      - {{ homedir }}/.docker/caddy/config:/config
    tmpfs:
      - /tmp
