services:
  caddy:
    image: {{ image }}
    build:
      context: {{ homedir }}/.docker/caddy/build
    container_name: caddy
    restart: unless-stopped
    network_mode: host
    user: "{{ uid }}:{{ gid }}"
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
    env_file:
      - {{ homedir }}/.docker/caddy/hetzner.env
    environment:
      XDG_DATA_HOME: /data
      XDG_CONFIG_HOME: /config
    volumes:
      - caddy_config_files:/etc/pyinfra-caddy:ro
      - dehydrated_data:/var/lib/dehydrated
      - caddy_data:/data
      - caddy_state:/config
    tmpfs:
      - /tmp
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://127.0.0.1:2019/config/ >/dev/null"]
      interval: 10s
      timeout: 3s
      retries: 6
      start_period: 30s

volumes:
  caddy_config_files:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ homedir }}/.docker/caddy/config-files"
  dehydrated_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ homedir }}/.docker/caddy/dehydrated"
  caddy_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ homedir }}/.docker/caddy/data"
  caddy_state:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ homedir }}/.docker/caddy/config"
