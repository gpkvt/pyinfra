[Unit]
Description={{ description }}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ homedir }}/{{ service }}
ExecStart=/usr/bin/docker compose up -d
{% if stop_dependencies %}ExecStop=/usr/bin/docker compose down{% else %}ExecStop=/usr/bin/docker compose stop {{ app_services | join(" ") }}{% endif %}

TimeoutStartSec=120
TimeoutStopSec=120

{% if sablier_enabled %}
[X-Sablier]
Enable=true
Group={{ sablier_group }}
{% endif %}

[Install]
WantedBy=default.target
