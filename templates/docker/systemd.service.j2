[Unit]
Description={{ description }}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ homedir }}/.docker/{{ service }}
{% if sablier_enabled %}
ExecStart=/usr/bin/docker compose {{ compose_files }} up --no-start
{% else %}
ExecStart=/usr/bin/docker compose {{ compose_files }} up -d
{% endif %}
{% if stop_dependencies %}ExecStop=/usr/bin/docker compose {{ compose_files }} down{% else %}ExecStop=/usr/bin/docker compose {{ compose_files }} stop {{ app_services | join(" ") }}{% endif %}
TimeoutStartSec=120
TimeoutStopSec=120

[Install]
WantedBy=default.target
