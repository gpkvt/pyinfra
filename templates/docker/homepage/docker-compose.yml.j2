services:
  homepage:
    image: {{ image }}
    container_name: homepage
    restart: unless-stopped

    ports:
      - "127.0.0.1:{{ port }}:3000"

    environment:
      HOMEPAGE_ALLOWED_HOSTS: "{{ domain }}"
{% for key, value in environment.items() %}
      {{ key }}: {{ value | tojson }}
{% endfor %}

    extra_hosts:
      - "host.docker.internal:host-gateway"
      # Resolve public service hostnames to the Docker host from inside
      # Homepage. Caddy routes HTTPS requests by hostname to loopback services.
      - "rss.21x9.org:host-gateway"
      - "forgejo.21x9.org:host-gateway"
      - "portainer.21x9.org:host-gateway"

    volumes:
      - {{ homedir }}/.docker/homepage/config:/app/config
      - {{ homedir }}/.docker/homepage/public/icons:/app/public/icons
      - {{ homedir }}/.docker/homepage/public/images:/app/public/images
