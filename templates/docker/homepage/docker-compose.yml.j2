services:
  homepage:
    image: {{ image }}
    container_name: homepage
    restart: unless-stopped

    ports:
      - "127.0.0.1:{{ port }}:3000"

    environment:
      HOMEPAGE_ALLOWED_HOSTS: "{{ domain }}"
{% for key, value in environment.items() %}
      {{ key }}: {{ value | tojson }}
{% endfor %}

    volumes:
      - {{ homedir }}/.docker/homepage/config:/app/config
      - {{ homedir }}/.docker/homepage/public/icons:/app/public/icons
      - {{ homedir }}/.docker/homepage/public/images:/app/public/images
