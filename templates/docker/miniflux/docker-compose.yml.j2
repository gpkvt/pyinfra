services:
  miniflux:
    restart: unless-stopped
    image: miniflux/miniflux:latest
    ports:
      - "127.0.0.1:{{ port }}:8080"
    depends_on:
      - db
    environment:
      - DATABASE_URL=postgres://miniflux:{{ postgres_password }}@db/miniflux?sslmode=disable
      - RUN_MIGRATIONS=True
      - ADMIN_USERNAME={{ admin_username }}
      - ADMIN_PASSWORD={{ admin_password }}
      - PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      - LISTEN_ADDR=0.0.0.0:8080
      - POLLING_SCHEDULER=entry_frequency
      - SCHEDULER_ENTRY_FREQUENCY_MAX_INTERVAL=720
      - SCHEDULER_ENTRY_FREQUENCY_MIN_INTERVAL=1
      - POLLING_FREQUENCY=15
      - FORCE_REFRESH_INTERVAL=1
  db:
    restart: always
    image: postgres:{{ postgres_version }}
    environment:
      - POSTGRES_USER=miniflux
      - POSTGRES_PASSWORD={{ postgres_password }}
      - PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/lib/postgresql/12/bin
      - GOSU_VERSION=1.14
      - LANG=en_US.utf8
      - PG_MAJOR={{ postgres_version }}
      - PG_VERSION={{ postgres_version }}.11-1.pgdg110+1
      - PGDATA=/var/lib/postgresql/data
    volumes:
      - {{ homedir }}/.docker/miniflux/db:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "miniflux"]
      interval: 10s
      start_period: 30s
