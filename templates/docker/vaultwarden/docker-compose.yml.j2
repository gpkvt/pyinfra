services:
  vaultwarden:
    image: {{ image }}
    restart: always
    ports:
      - "127.0.0.1:{{ port }}:80"
    environment:
      DOMAIN: "{{ domain }}"
      SIGNUPS_ALLOWED: "false"
      INVITATIONS_ALLOWED: "false"
      ADMIN_TOKEN: "${ADMIN_TOKEN:-}"
    volumes:
      - {{ homedir }}/.docker/vaultwarden:/data
