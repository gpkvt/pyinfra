services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: "{{ postgres_password | replace('$', '$$') }}"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  meilisearch:
    image: getmeili/meilisearch:v1.13.3
    restart: unless-stopped
    environment:
      MEILI_MASTER_KEY: "{{ meili_master_key | replace('$', '$$') }}"
    volumes:
      - meili_data:/meili_data

  linkwarden:
    image: {{ image }}
    container_name: linkwarden
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ port }}:3000"
    environment:
      DATABASE_URL: "postgresql://postgres:{{ postgres_password | replace('$', '$$') }}@postgres:5432/postgres"
      NEXTAUTH_URL: "https://{{ domain }}/api/v1/auth"
      NEXTAUTH_SECRET: "{{ nextauth_secret | replace('$', '$$') }}"
      MEILI_HOST: "http://meilisearch:7700"
      MEILI_MASTER_KEY: "{{ meili_master_key | replace('$', '$$') }}"
    volumes:
      - linkwarden_data:/data/data
    depends_on:
      - postgres
      - meilisearch

volumes:
  postgres_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ homedir }}/.docker/linkwarden/postgres"
  linkwarden_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ homedir }}/.docker/linkwarden/data"
  meili_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ homedir }}/.docker/linkwarden/meili"
