services:
  wallabag:
    image: {{ image }}
    restart: always
    ports:
      - "127.0.0.1:{{ port }}:80"
    environment:
      SYMFONY__ENV__DOMAIN_NAME: "{{ domain }}"
      SYMFONY__ENV__FOSUSER_REGISTRATION: "false"
      SYMFONY__ENV__FOSUSER_CONFIRMATION: "true"
    volumes:
      - wallabag_data:/var/www/wallabag/data
      - wallabag_images:/var/www/wallabag/web/assets/images

volumes:
  wallabag_data:
  wallabag_images:
