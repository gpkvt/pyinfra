services:
  wg-easy:
    image: {{ image }}
    container_name: wg-easy
    restart: unless-stopped
    environment:
      INSECURE: "true"
    ports:
      - "51820:51820/udp"
      - "127.0.0.1:{{ ui_port }}:51821/tcp"
    cap_add:
      - NET_ADMIN
    sysctls:
      net.ipv4.ip_forward: "1"
      net.ipv4.conf.all.src_valid_mark: "1"
    volumes:
      - wg_easy_data:/etc/wireguard

volumes:
  wg_easy_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ homedir }}/.docker/wg-easy"
