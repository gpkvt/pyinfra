# Sablier discovers groups dynamically from Docker container labels.
# Every managed container must have sablier.enable=true and sablier.group.
provider:
  name: docker
  reject-unlabeled-requests: true
  docker:
    strategy: {{ provider_strategy }}
sessions:
  default-duration: {{ default_duration }}
  expiration-interval: 10s
server:
  port: 10000
logging:
  level: info
