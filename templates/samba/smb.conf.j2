[global]
   workgroup = {{ workgroup }}
   server string = {{ server_string }}
   server role = standalone server
   security = user
   map to guest = Bad User
   server min protocol = SMB2
   disable netbios = yes
   smb ports = 445
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   interfaces = lo {{ interface }}
   bind interfaces only = yes

[Upload]
   path = {{ upload_path }}
   browseable = yes
   read only = no
   guest ok = yes
   guest only = yes
   force user = nobody
   force group = nogroup
   create mask = 0660
   directory mask = 0770
   comment = Shared guest upload dropbox

[Download]
   path = {{ download_path }}
   browseable = yes
   read only = yes
   guest ok = yes
   guest only = yes
   force user = nobody
   force group = nogroup
   comment = Read-only file downloads
