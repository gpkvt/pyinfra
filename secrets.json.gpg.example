{
    "shared": {
        "git_credentials": [
            "https://user:REPLACE_WITH_PASSWORD@gitea.org"
        ]
    },
    "hosts": {
        "@local": {
            "dehydrated": {
                "hetzner_api_token": "REPLACE_WITH_TOKEN"
            },
            "wireguard": {
                "home": {
                    "privatekey": "REPLACE_WITH_PRIVATE_KEY",
                    "peers": [
                        {
                            "PublicKey": "REPLACE_WITH_PUBLIC_KEY",
                            "PresharedKey": "REPLACE_WITH_PRESHARED_KEY",
                            "AllowedIPs": "0.0.0.0/0,::/0",
                            "Endpoint": "vpn.example.com:51820",
                            "PersistentKeepalive": 25
                        }
                    ]
                }
            },
            "docker": {
                "vaultwarden": {
                    "admin_token": "REPLACE_WITH_ARGON2_PHC_HASH"
                },
                "miniflux": {
                    "admin_username": "admin@example.com",
                    "admin_password": "REPLACE_WITH_PASSWORD",
                    "postgres_password": "REPLACE_WITH_PASSWORD"
                },
                "linkwarden": {
                    "postgres_password": "REPLACE_WITH_URL_SAFE_PASSWORD",
                    "nextauth_secret": "REPLACE_WITH_RANDOM_SECRET",
                    "meili_master_key": "REPLACE_WITH_RANDOM_SECRET"
                },
                "homepage": {
                    "environment": {
                        "HOMEPAGE_VAR_MINIFLUX_API_KEY": "REPLACE_WITH_MINIFLUX_API_KEY",
                        "HOMEPAGE_VAR_FORGEJO_API_KEY": "REPLACE_WITH_FORGEJO_API_KEY",
                        "HOMEPAGE_VAR_PORTAINER_API_KEY": "REPLACE_WITH_PORTAINER_API_KEY"
                    }
                }
            },
            "ssh": {
                "default_passphrase": "REPLACE_WITH_PASSPHRASE",
                "id_ed25519": {
                    "passphrase": "REPLACE_WITH_PASSPHRASE"
                },
                "id_github": {
                    "passphrase": "REPLACE_WITH_PASSPHRASE"
                }
            }
        },
        "dns": {
            "dehydrated": {
                "hetzner_api_token": "REPLACE_WITH_DNS_HOST_TOKEN"
            },
            "ssh": {
                "default_passphrase": "REPLACE_WITH_DNS_HOST_PASSPHRASE"
            }
        }
    }
}
