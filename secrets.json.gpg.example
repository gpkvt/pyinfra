{
    "shared": {
        "git_credentials": [
            "https://user:REPLACE_WITH_PASSWORD@gitea.org"
        ]
    },
    "hosts": {
        "@local": {
            "dehydrated": {
                "hetzner_api_token": "REPLACE_WITH_TOKEN"
            },
            "wireguard": {
                "home": {
                    "privatekey": "REPLACE_WITH_PRIVATE_KEY",
                    "peers": [
                        {
                            "PublicKey": "REPLACE_WITH_PUBLIC_KEY",
                            "PresharedKey": "REPLACE_WITH_PRESHARED_KEY",
                            "AllowedIPs": "0.0.0.0/0,::/0",
                            "Endpoint": "vpn.example.com:51820",
                            "PersistentKeepalive": 25
                        }
                    ]
                }
            },
            "docker": {
                "vaultwarden": {
                    "admin_token": "REPLACE_WITH_ARGON2_PHC_HASH"
                },
                "miniflux": {
                    "admin_username": "admin@example.com",
                    "admin_password": "REPLACE_WITH_PASSWORD",
                    "postgres_password": "REPLACE_WITH_PASSWORD"
                },
                "paperless": {
                    "postgres_password": "REPLACE_WITH_URL_SAFE_PASSWORD",
                    "secret_key": "REPLACE_WITH_RANDOM_SECRET"
                },
                "firefly-iii": {
                    "database_password": "REPLACE_WITH_URL_SAFE_PASSWORD",
                    "mysql_root_password": "REPLACE_WITH_URL_SAFE_PASSWORD",
                    "app_key": "REPLACE_WITH_32_CHARACTER_BASE64_APP_KEY",
                    "cron_token": "REPLACE_WITH_EXACTLY_32_RANDOM_CHARACTERS"
                },
                "snipe-it": {
                    "database_password": "REPLACE_WITH_URL_SAFE_PASSWORD",
                    "mysql_root_password": "REPLACE_WITH_URL_SAFE_PASSWORD",
                    "app_key": "REPLACE_WITH_GENERATED_LARAVEL_APP_KEY"
                },
                "appflowy": {
                    "postgres_password": "REPLACE_WITH_AT_LEAST_32_URL_SAFE_CHARACTERS",
                    "admin_password": "REPLACE_WITH_AT_LEAST_16_URL_SAFE_CHARACTERS",
                    "jwt_secret": "REPLACE_WITH_AT_LEAST_32_URL_SAFE_CHARACTERS",
                    "minio_access_key": "REPLACE_WITH_EXACTLY_20_URL_SAFE_CHARACTERS",
                    "minio_secret_key": "REPLACE_WITH_AT_LEAST_32_URL_SAFE_CHARACTERS"
                },
                "linkwarden": {
                    "postgres_password": "REPLACE_WITH_URL_SAFE_PASSWORD",
                    "nextauth_secret": "REPLACE_WITH_RANDOM_SECRET",
                    "meili_master_key": "REPLACE_WITH_RANDOM_SECRET"
                },
                "homepage": {
                    "environment": {
                        "HOMEPAGE_VAR_MINIFLUX_API_KEY": "REPLACE_WITH_MINIFLUX_API_KEY",
                        "HOMEPAGE_VAR_FORGEJO_API_KEY": "REPLACE_WITH_FORGEJO_API_KEY",
                        "HOMEPAGE_VAR_PORTAINER_API_KEY": "REPLACE_WITH_PORTAINER_API_KEY",
                        "HOMEPAGE_VAR_PAPERLESS_API_KEY": "REPLACE_WITH_PAPERLESS_API_KEY",
                        "HOMEPAGE_VAR_LINKWARDEN_API_KEY": "REPLACE_WITH_LINKWARDEN_API_KEY",
                        "HOMEPAGE_VAR_OPENWEATHERMAP_API_KEY": "REPLACE_WITH_OPENWEATHERMAP_API_KEY"
                    }
                },
                "wg-easy": {
                    "image": "ghcr.io/wg-easy/wg-easy:15",
                    "ui_port": 51821,
                },
                "wallabag": {
                    "image": "wallabag/wallabag:latest",
                    "port": 8017,
                    "domain": "https://wallabag.21x9.org",
                },
            },
            "ssh": {
                "default_passphrase": "REPLACE_WITH_PASSPHRASE",
                "id_ed25519": {
                    "passphrase": "REPLACE_WITH_PASSPHRASE"
                },
                "id_github": {
                    "passphrase": "REPLACE_WITH_PASSPHRASE"
                }
            }
        },
        "dns": {
            "dehydrated": {
                "hetzner_api_token": "REPLACE_WITH_DNS_HOST_TOKEN"
            },
            "ssh": {
                "default_passphrase": "REPLACE_WITH_DNS_HOST_PASSPHRASE"
            }
        }
    }
}
