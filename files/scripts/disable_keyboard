#!/usr/bin/env bash
set -e

DEVICE="serio0"
DRIVER="/sys/bus/serio/drivers/atkbd"

cleanup() {
    if [ ! -L "/sys/bus/serio/devices/$DEVICE/driver" ]; then
        echo "$DEVICE" > "$DRIVER/bind"
    fi
}

handle_signal() {
    local exit_status="$1"
    trap - EXIT INT TERM
    cleanup
    exit "$exit_status"
}

trap cleanup EXIT
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM
echo "$DEVICE" > "$DRIVER/unbind"
echo "Keyboard disabled, wait for automatic re-enabling."

for i in {120..1}; do
    printf "\rKeyboard disabled: %3d seconds remaining" "$i"
    sleep 1
done
printf "\n"

echo "Restoring keyboard..."
cleanup
trap - EXIT
echo "Keyboard restored."
