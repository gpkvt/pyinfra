#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${DOCKER_POWER_CONFIG:-/etc/docker/battery-containers.conf}"
source "$CONFIG_FILE"

STATE_DIR="${DOCKER_POWER_STATE_DIR:-/var/lib/docker-power-manager}"
STATE_FILE="$STATE_DIR/running-containers"
STATE_COMPLETE="$STATE_FILE.complete"

mkdir -p "$STATE_DIR"

case "${1:-}" in
    battery)
        # A partial state file means a previous stop attempt failed. Retry
        # unfinished containers until the complete marker can be written.
        [[ -e "$STATE_COMPLETE" ]] && exit 0
        touch "$STATE_FILE"

        for container in "${BATTERY_CONTAINERS[@]}"; do
            if docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null | grep -q true; then
                grep -Fxq "$container" "$STATE_FILE" || echo "$container" >> "$STATE_FILE"
                docker stop "$container"
            fi
        done
        ;;

    ac)
        if [[ -f "$STATE_FILE" ]]; then
            while IFS= read -r container; do
                [[ -n "$container" ]] || continue
                docker start "$container"
            done < "$STATE_FILE"

            rm -f "$STATE_FILE" "$STATE_COMPLETE"
        fi
        ;;

    *)
        echo "Usage: $0 {battery|ac}" >&2
        exit 1
        ;;
esac
