# pylint: disable=C0103  # Keep pyinfra's configuration variable names unchanged.
"""Portable example for per-machine pyinfra configuration.

Copy this file to @local.py and replace every placeholder before deploying.
Keep machine-specific values, credentials, private keys and device identifiers
in the ignored local file, never in this tracked example.

Every setting below is read by one or more tasks. Empty collections disable
optional features unless noted otherwise. Uncomment service examples only
when you intend to deploy that service.
"""

# Identity and operating-system settings.
hostname = "example-host"  # Sets /etc/hostname and the system hostname.
timezone = "Etc/UTC"  # Timezone database name used by the OS and services.
locale = "en_US.UTF-8"  # System locale; the locale must be available on the target.
username = "YOUR_USERNAME"  # Primary non-root account used by user-level tasks.
usergroup = "YOUR_USERNAME"  # Primary group used for ownership of user files.
homedir = "/home/YOUR_USERNAME"  # Absolute home directory; also roots user data mounts.
editor = "nano"  # Default command-line editor exported to the user's environment.
visual_editor = "nano"  # GUI/editor command; falls back to editor when omitted.

keyboard = {  # XKB keyboard settings applied to the system.
    "layout": "us",  # Keyboard layout code, e.g. "us" or "de".
    "model": "pc105",  # XKB keyboard model; "pc105" is common for full keyboards.
    "variant": "",  # Optional layout variant, e.g. "intl"; empty uses the default.
    "options": "",  # Optional XKB options, e.g. "grp:alt_shift_toggle".
}

# Network and name resolution.
local_network_cidr = ""  # Local IPv4 CIDR used by the VPN task to detect LAN presence.
hostnames = {}  # /etc/hosts mappings: {"192.0.2.10": ["host.example", "host"]}.
wireguard_interface = None  # Interface used by wg-quick, e.g. "home"; None disables VPN startup.
wireguard_enabled = True  # Master gate for deploying configured WireGuard interfaces.
vpn_enabled = True  # Master gate for automatic VPN activation outside local_network_cidr.
wireguard_config = {}  # WireGuard interfaces keyed by name; private/peer keys belong in secrets.
# Example interface settings (the matching privatekey and peers go in encrypted secrets):
# wireguard_config = {
#     "home": {
#         "interface": {
#             "Address": ["10.10.0.2/32"],  # Tunnel address assigned to this host.
#             "DNS": "10.10.0.1",  # DNS resolver used while this interface is active.
#             "MTU": 1420,  # Optional interface MTU.
#         },
#     },
# }
# secrets.json.gpg must contain hosts["@local"]["wireguard"]["home"] with:
# privatekey (interface private key) and peers (list of peer dictionaries containing PublicKey,
# AllowedIPs, and optional PresharedKey, Endpoint and PersistentKeepalive).

# On-demand Samba file exchange. Disabled until explicitly enabled.
samba = {
    "enabled": False,  # Install and configure Samba; it remains stopped until samba-start.
    "interface": "lo",  # Network interface Samba listens on, in addition to loopback; e.g. "enp3s0".
    "allowed_networks": [
        # "192.168.1.0/24",  # Trusted LAN CIDR.
        # "10.20.0.0/24",  # Trusted VPN CIDR.
    ],  # Required, non-empty IPv4/IPv6 CIDR list when enabled.
    "idle_timeout": 1800,  # Seconds without SMB traffic before automatic shutdown; 0 disables the monitor.
    "workgroup": "WORKGROUP",  # SMB workgroup name.
    "server_string": "On-demand file exchange",  # Description displayed by SMB clients.
    "upload": {
        "path": "/srv/samba/upload",  # Shared writable guest upload directory.
    },
    "download": {
        "path": "/srv/samba/download",  # Guest-readable, read-only download directory.
    },
}

# User shell and terminal tools.
zsh = False  # Installs/configures Zsh and the LiMusic-aware HyFetch music helper.
zshrc_imports = []  # Extra Zsh files sourced from the user's ~/.zshrc.
zplug_plugins = []  # Zplug plugin identifiers loaded by the Zsh configuration.
powerline = False  # Deploys the Powerline shell prompt configuration.
powerline_fonts = False  # Downloads/installs Powerline-patched fonts when enabled.
tmux = True  # Deploys the user's tmux configuration.

# Core packages and operating-system policy.
apt_packages = []  # Additional APT package names to install.
apt_sources = {}  # Third-party APT repositories; signing keys must use .gpg, .asc or .key paths.
# Example (leave enabled=False until the repository is trusted and verified):
# apt_sources = {
#     "example": {
#         "enabled": False,  # Set True to download the key and configure this repository.
#         "key": {
#             "url": "https://packages.example.org/repo-signing-key.asc",  # HTTPS URL of the repository signing key.
#             "path": "/etc/apt/keyrings/example.asc",  # Absolute keyring destination; extension must match key format.
#             # "keyid": "0123456789ABCDEF",  # Optional key fingerprint/key ID for verification.
#         },
#         "repository": {
#             "url": "https://packages.example.org/debian",  # APT repository base URL.
#             "distribution": "stable",  # Distribution or suite name.
#             "components": ["main"],  # Repository components; may be empty for repositories without components.
#             "architectures": ["amd64"],  # Optional architecture filter; omit to use APT defaults.
#             "types": ["deb"],  # APT source types, normally ["deb"] or ["deb", "deb-src"].
#         },
#     },
# }
flatpak_packages = []  # Flatpak application IDs installed for the configured user from Flathub when possible.
sysctl = {}  # Kernel sysctl settings, e.g. {"net.ipv4.ip_forward": 1}.
udev = {}  # udev rules keyed by rule filename, with rule contents as values.
usbguard = {  # USBGuard daemon configuration; disabled unless explicitly enabled.
    "enabled": False,  # Installs/enables USBGuard when True.
    "rules": [],  # USBGuard policy rules; review carefully to avoid locking out devices.
}
sudoers_rules = []  # Additional sudoers lines; validated with visudo before deployment.
apparmor_profiles = []  # AppArmor profile paths/names to load and enforce.

# SSH configuration. Private-key passphrases are read from encrypted secrets.
ssh_keys = []  # SSH keypairs to generate; existing private keys are never overwritten.
# Example: {"name": "id_ed25519", "type": "ed25519", "comment": "user@host"}.
# RSA entries may also set "bits" (minimum 3072); passphrases belong in secrets.json.gpg.
ssh_authorized_keys = {}  # Authorized keys keyed by target user, e.g. {"YOUR_USERNAME": ["ssh-ed25519 AAAA..."]}.
# Example: {"YOUR_USERNAME": ["ssh-ed25519 AAAAC3... workstation"]}; keys are reconciled exactly.
ssh_authorized_keys_enabled = True  # Set False to skip authorized_keys management entirely.
ssh_config = {}  # SSH client Host entries: {"git.example.com": "    User git\\n    IdentityFile ~/.ssh/id_ed25519"}.

# Optional desktop applications and browser customization.
vscodium = {  # VSCodium extension configuration.
    "extensions": [],  # Marketplace extension IDs to install for the configured user.
}
proton = {  # Proton application configuration; defining this mapping enables the Proton task.
    # All application switches default to True when this mapping is enabled.
    # "mail": False,  # Install Proton Mail; defaults to True.
    # "bridge": False,  # Install Proton Mail Bridge; defaults to True.
    # "vpn": False,  # Install Proton VPN; defaults to True.
    # "pass": False,  # Install Proton Pass; defaults to True.
    # "flatpak": True,  # Install Mail/Bridge/Pass through Flathub; defaults to True.
    # "drive_cli": True,  # Install Proton Drive CLI; defaults to True.
    "drive_cli_version": "0.9.0",  # Required release pin when drive_cli is enabled.
}
mullvad_extensions = {}  # Browser extensions keyed by name; each entry requires an add-on id and HTTPS XPI URL.
# Example: {"uBlock Origin": {"id": "uBlock0@raymondhill.net", "url": "https://addons.mozilla.org/...xpi"}}.
mullvad_browser_dir = None  # Optional Mullvad Browser profile directory; None uses task defaults.

# Docker services. Keep this empty to deploy no application containers.
# Each service is enabled by adding its own dictionary. All persistent service
# data is stored in host directories below homedir/.docker/ (never named volumes).
docker_install = True  # Install Docker itself when docker services are configured; False if managed elsewhere.
docker_power_monitor = True  # Deploy the Docker battery monitor when Docker services are configured.
docker = {
    # "forgejo": {  # Self-hosted Git service; secrets are not stored here.
    #     "image": "codeberg.org/forgejo/forgejo:17",  # Container image/tag.
    #     "port": 3000,  # Web interface port published on the host.
    #     "ssh_port": 2222,  # SSH clone port published on the host.
    #     "ssh_server": False,  # Expose the container's SSH server when True.
    #     "domain": "git.example.com",  # Public URL used by the service/reverse proxy.
