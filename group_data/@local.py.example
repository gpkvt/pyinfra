    #     "domain": "docs.example.com",  # Public URL used by the service.
    #     "uid": 1000,  # UID used by the Paperless container for file access.
    #     "gid": 1000,  # GID used by the Paperless container for file access.
    # },
    # "firefly-iii": {  # Personal finance manager; database/app secrets belong in secrets.
    #     "image": "fireflyiii/core:latest",  # Application image/tag.
    #     "port": 8023,  # Main web interface port.
    #     "domain": "finance.example.com",  # Public application hostname.
    #     "fints_port": 8024,  # Optional Firefly III FINTS importer port.
    #     "fints_domain": "fints.example.com",  # Optional FINTS importer hostname.
    # },
    # "appflowy": {  # AppFlowy workspace; all required credentials belong in secrets.
    #     "port": 8026,  # Web interface port published on the host.
    #     "domain": "appflowy.example.com",  # Public application hostname.
    #     "admin_email": "admin@example.com",  # Initial administrator email.
    #     "app_services": ["nginx"],  # Compose services to start for this deployment.
