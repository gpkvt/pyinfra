}

caddy_versions = {  # Pinned versions used to build the custom Caddy image.
    "version": "2.11.2",  # Caddy version used by both builder and runtime images.
    "sablier_plugin": "v1.0.2",  # Sablier Caddy plugin release.
    "dehydrated": "0.7.2",  # Dehydrated release downloaded into the image.
}
docker_sablier = {  # Enables on-demand Docker container startup via Sablier.
    "enabled": False,
    "version": "1.20.0",  # Sablier server image version.  # Sablier and the Docker battery monitor are mutually exclusive.
    "default_duration": "15m",  # Default container session duration (e.g. 15m or 1h).
    "provider_strategy": "pause",  # Idle Docker behaviour: "pause" retains RAM; "stop" frees it.
    # "strategy": "dynamic",  # Default Caddy integration strategy: "dynamic" or "blocking".
    # "blocking_timeout": "15m",  # Maximum wait for a blocking start request.
    # "default_theme": "ghost",  # Theme used by Sablier's dynamic service cards.
    # "refresh_frequency": "5s",  # Polling interval for dynamic service status.
}  # Per-service overrides live under docker.<service>.sablier.
docker_power_save = []  # Docker container names (not Compose service names unless they match); stopped on battery, restored on AC power.
caddy_enabled = True  # Allow the Caddy task when Docker and caddy_config are both configured.
apparmor_enabled = True  # Master gate for loading apparmor_profiles.
mullvad_browser_enabled = True  # Master gate for managing mullvad_extensions.
vscodium_enabled = True  # Master gate for installing configured VSCodium extensions.

# Reverse proxy, certificates and background services.
caddy_config = {}  # Caddy sites keyed by hostname; each value is a mapping of Caddy directives.
# Example: {"example.com": {"encode": "gzip", "reverse_proxy": "127.0.0.1:8080"}}.
# Add only sites not already generated from configured Docker services.
dehydrated_domains = []  # Each item is a list of DNS names covered by one certificate; Hetzner token belongs in secrets.
# Example: [["example.com", "*.example.com"], ["other.example.net"]].
cron_jobs = []  # Named cron jobs; each needs name, command and at least one schedule field.
syncthing = {}  # Syncthing settings; an empty mapping keeps the GUI on its safe loopback default.
# Example: {"gui_address": "127.0.0.1:8384"}; avoid exposing the GUI without authentication.

# Firewall is deliberately disabled in this example.
ufw = {}  # UFW rules; only populate after verifying remote access and SSH allowances.
# Supported keys: "ssh", "kdeconnect", "localsend", "chromecast-dlna".
# Example: {"ssh": "Allow", "localsend": "Allow"}; values may be "Allow" or "Deny".
# Custom rules may use {"action": "Allow", "rule": "443/tcp"} after careful review.
